<Window x:Class="Wave.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:Wave.App"
        xmlns:controls="using:Wave.App.Controls"
        xmlns:music="using:Wave.Core.Music"
        Title="wave">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <!-- 並びは Spotify のデスクトップ版と同じ: 上に検索、左にマイライブラリ、中央にページ、右に再生中の曲、下に再生の操作 -->
    <Grid x:Name="Root" PreviewKeyDown="OnRootKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="wave" IsBackButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/wave.png" />
            </TitleBar.IconSource>
            <TitleBar.LeftHeader>
                <!-- 戻る・進む（同じ大きさの2つのボタン。タイトルバー備え付けの戻るは使わない） -->
                <StackPanel Orientation="Horizontal" Spacing="2" Margin="4,0,4,0" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Style="{StaticResource IconButtonStyle}" Click="OnBackClick" IsEnabled="False"
                            ToolTipService.ToolTip="{x:Bind app:L.T('戻る', 'Back')}" Height="32" Width="40" MinHeight="32" Padding="0">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" />
                    </Button>
                    <Button x:Name="ForwardButton" Style="{StaticResource IconButtonStyle}" Click="OnForward" IsEnabled="False"
                            ToolTipService.ToolTip="{x:Bind app:L.T('進む', 'Forward')}" Height="32" Width="40" MinHeight="32" Padding="0">
                        <FontIcon Glyph="&#xE72A;" FontSize="12" />
                    </Button>
                </StackPanel>
            </TitleBar.LeftHeader>
            <TitleBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button x:Name="HomeButton" Click="OnHome" ToolTipService.ToolTip="{x:Bind app:L.T('ホーム', 'Home')}" CornerRadius="16" Height="32" Width="40" Padding="0">
                        <FontIcon Glyph="&#xE80F;" FontSize="14" />
                    </Button>
                    <AutoSuggestBox x:Name="SearchBox" Width="440" VerticalAlignment="Center" MaxSuggestionListHeight="640" PlaceholderText="{x:Bind app:L.T('何を聴きたいですか？', 'What do you want to play?')}"
                                    QueryIcon="Find" TextChanged="OnSearchTextChanged" QuerySubmitted="OnSearchSubmitted"
                                    GotFocus="OnSearchFocus" UpdateTextOnSelect="False">
                        <AutoSuggestBox.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="K" Invoked="OnFocusSearch" />
                            <KeyboardAccelerator Modifiers="Control" Key="L" Invoked="OnFocusSearch" />
                        </AutoSuggestBox.KeyboardAccelerators>
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="app:Suggestion">
                                <Grid ColumnSpacing="12" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="{x:Bind app:Ui.Radius(Round)}" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <Grid>
                                            <FontIcon Glyph="&#xE721;" FontSize="14" Visibility="{x:Bind app:Ui.Show(IsQuery)}" />
                                            <Image Source="{x:Bind app:Ui.Small(ThumbnailUrl)}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource SubtleTextStyle}" Visibility="{x:Bind app:Ui.ShowText(Subtitle)}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                </StackPanel>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <Button x:Name="AccountButton" Style="{StaticResource IconButtonStyle}" Padding="2" Margin="0,0,8,0" ToolTipService.ToolTip="{x:Bind app:L.T('アカウント', 'Account')}">
                    <PersonPicture x:Name="AccountPicture" Width="30" Height="30" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="AccountMenu" Placement="BottomEdgeAlignedRight" Opening="OnAccountMenuOpening" />
                    </Button.Flyout>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <Grid x:Name="Body" Grid.Row="1" Padding="8,0,8,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LibraryColumn" Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightColumn" Width="340" />
            </Grid.ColumnDefinitions>

            <!-- マイライブラリ -->
            <Border Style="{StaticResource PaneStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="16,12,8,4">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8F1;" FontSize="18" />
                            <TextBlock Text="{x:Bind app:L.T('マイライブラリ', 'Your Library')}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                        <Button x:Name="CreateButton" HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Click="OnCreatePlaylist" ToolTipService.ToolTip="{x:Bind app:L.T('プレイリストを作成', 'Create playlist')}">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                        </Button>
                    </Grid>
                    <StackPanel x:Name="FilterChips" Grid.Row="1" Orientation="Horizontal" Spacing="6" Padding="12,4" />
                    <Grid Grid.Row="2" Padding="12,4,8,4" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LibraryFilter" PlaceholderText="{x:Bind app:L.T('マイライブラリを検索', 'Search in Your Library')}" TextChanged="OnLibraryFilterChanged" />
                        <DropDownButton x:Name="SortButton" Grid.Column="1" Content="{x:Bind app:L.T('最近', 'Recents')}" Background="Transparent" BorderThickness="0">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <RadioMenuFlyoutItem Text="{x:Bind app:L.T('最近', 'Recents')}" GroupName="sort" IsChecked="True" Tag="recent" Click="OnSort" />
                                    <RadioMenuFlyoutItem Text="{x:Bind app:L.T('アルファベット順', 'Alphabetical')}" GroupName="sort" Tag="alpha" Click="OnSort" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>
                    <ListView x:Name="LibraryList" Grid.Row="3" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnLibraryClick" Padding="4,0,4,8">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="Padding" Value="8,0" />
                                <Setter Property="MinHeight" Value="60" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="app:LibraryEntry">
                                <Grid ColumnSpacing="12" RightTapped="OnLibraryRightTapped">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="{x:Bind app:Ui.Radius(IsArtist)}" Background="{x:Bind CoverBackground}">
                                        <Grid>
                                            <FontIcon Glyph="&#xEB52;" Foreground="White" FontSize="18" Visibility="{x:Bind app:Ui.Show(IsLiked)}" />
                                            <Image Source="{x:Bind app:Ui.Small(ThumbnailUrl)}" Stretch="UniformToFill" Visibility="{x:Bind app:Ui.Hide(IsLiked)}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource SubtleTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="LoggedOutPanel" Grid.Row="3" Spacing="12" Padding="16" Visibility="Collapsed">
                        <TextBlock Text="{x:Bind app:L.T('ログインすると、YouTube Music のプレイリスト・アーティスト・アルバムがここに並びます。', 'Log in to see your YouTube Music playlists, artists and albums here.')}" TextWrapping="Wrap" />
                        <Button Content="{x:Bind app:L.T('ログイン', 'Log in')}" Style="{StaticResource AccentButtonStyle}" Click="OnLogin" />
                    </StackPanel>
                    <ProgressBar x:Name="LibraryLoading" Grid.Row="3" IsIndeterminate="True" VerticalAlignment="Top" Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- 中央のページ -->
            <Border Grid.Column="1" Style="{StaticResource PaneStyle}">
                <Grid>
                    <Frame x:Name="ContentFrame" Navigated="OnNavigated" />
                    <!-- 知らせ（Android のスナックバーと同じく、下の細いバーが消えるまでの残り時間を表す） -->
                    <!-- 箱の角で切り取り、バーを箱の下の縁に沿わせる -->
                    <Border x:Name="ToastFrame" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16" MaxWidth="560" MinWidth="320"
                            CornerRadius="{ThemeResource ControlCornerRadius}" Visibility="Collapsed">
                        <Grid>
                            <InfoBar x:Name="Toast" IsOpen="False" Severity="Informational" IsClosable="True" Closed="OnToastClosed" />
                            <ProgressBar x:Name="ToastCountdown" Minimum="0" Maximum="1" Value="1" VerticalAlignment="Bottom" MinHeight="3"
                                         Background="Transparent" CornerRadius="0" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 右: 再生中の曲（Spotify の「再生中の画面」）とキュー -->
            <Border x:Name="RightPane" Grid.Column="2" Style="{StaticResource PaneStyle}">
                <Grid>
                    <ScrollViewer x:Name="NowPlayingView">
                        <StackPanel Padding="16" Spacing="16">
                            <TextBlock Text="{x:Bind PaneHeader(Player.Current), Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <!-- ジャケットか、MV のある曲では映像（Spotify と同じ「曲｜動画」の切り替え） -->
                            <Grid>
                                <Border x:Name="CoverBox" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}" Height="{x:Bind CoverSize, Mode=OneWay}">
                                    <Grid>
                                        <Image x:Name="CoverImage" Source="{x:Bind app:Ui.Large(Player.Current.ThumbnailUrl), Mode=OneWay}" Stretch="UniformToFill" />
                                        <MediaPlayerElement x:Name="PaneVideo" AreTransportControlsEnabled="False" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False" />
                                        <TextBlock x:Name="VideoNote" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Grid>
                                </Border>
                                <StackPanel x:Name="VideoSwitch" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" Visibility="Collapsed"
                                            Background="#99000000" CornerRadius="16" Padding="3">
                                    <ToggleButton x:Name="SongTab" CornerRadius="13" Padding="14,4" MinWidth="0" FontSize="12" IsChecked="True" Click="OnSongTab"
                                                  Content="{x:Bind app:L.T('曲', 'Song')}" />
                                    <ToggleButton x:Name="VideoTab" CornerRadius="13" Padding="14,4" MinWidth="0" FontSize="12" Click="OnVideoTab"
                                                  Content="{x:Bind app:L.T('動画', 'Video')}" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind SongTitleOrIdle(Player.Current), Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" />
                                    <HyperlinkButton Content="{x:Bind Player.Current.ArtistsText, Mode=OneWay}" Padding="0" Click="OnArtistLink" />
                                </StackPanel>
                                <!-- Android・Spotify と同じ: 評価していなければ＋（押すと評価）、評価済みなら✓（押すとプレイリストに追加する画面） -->
                                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Top" Click="OnLike" ToolTipService.ToolTip="{x:Bind LikeTip(Player.Like), Mode=OneWay}">
                                    <FontIcon Glyph="{x:Bind LikeGlyph(Player.Like), Mode=OneWay}" Foreground="{x:Bind LikeBrush(Player.Like), Mode=OneWay}" FontSize="20" />
                                </Button>
                            </Grid>
                            <!-- 歌詞（無い曲では箱ごと出さない）。全文を中で送り、歌っている行へ滑らかに動かす -->
                            <Button x:Name="LyricsCard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16" CornerRadius="8" Click="OnOpenLyrics" Visibility="Collapsed">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind app:L.T('歌詞', 'Lyrics')}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <ScrollViewer x:Name="LyricsScroller" Height="190" IsHitTestVisible="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled">
                                        <StackPanel x:Name="LyricsPreview" Padding="0,0,0,160" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Button>
                            <StackPanel Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Spacing="8">
                                <Grid>
                                    <TextBlock Text="{x:Bind app:L.T('次の曲', 'Next up')}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <HyperlinkButton Content="{x:Bind app:L.T('キューを開く', 'Open queue')}" HorizontalAlignment="Right" Padding="0" Click="OnShowQueue" />
                                </Grid>
                                <Grid ColumnSpacing="12" x:Name="NextSongPanel">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <Image x:Name="NextImage" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="NextTitle" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="NextArtist" Style="{StaticResource SubtleTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="QueueView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="16,12,8,4">
                            <TextBlock Text="{x:Bind app:L.T('キュー', 'Queue')}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Click="OnShowNowPlaying" ToolTipService.ToolTip="{x:Bind app:L.T('閉じる', 'Close')}">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </Grid>
                        <StackPanel x:Name="QueueEmpty" Grid.Row="1" Spacing="6" Padding="24" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="{x:Bind app:L.T('キューは空です', 'Your queue is empty')}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind app:L.T('曲を再生すると、ここに次の曲が並びます', 'Play something and upcoming songs will show up here')}" Style="{StaticResource SubtleTextStyle}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxLines="3" />
                        </StackPanel>
                        <ListView x:Name="QueueList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnQueueClick" Padding="4,0,4,8">
                            <ListView.Header>
                                <TextBlock Text="{x:Bind app:L.T('再生中', 'Now playing')}" Style="{StaticResource SubtleTextStyle}" Margin="12,4" />
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="app:QueueEntry">
                                    <Grid ColumnSpacing="12" Padding="0,6" RightTapped="OnQueueRightTapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                            <Image Source="{x:Bind app:Ui.Small(Song.ThumbnailUrl)}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Song.Title}" TextTrimming="CharacterEllipsis" Foreground="{x:Bind controls:Templates.TitleBrush(IsCurrent)}" />
                                            <TextBlock Text="{x:Bind Song.ArtistsText}" Style="{StaticResource SubtleTextStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 再生の操作（Spotify の下の帯: 左に曲、中央にボタンと位置、右に歌詞・キュー・音量） -->
        <Grid Grid.Row="2" MinHeight="88" Padding="16,10" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="4*" MaxWidth="720" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}" Tapped="OnArtTapped">
                    <Image Source="{x:Bind app:Ui.Small(Player.Current.ThumbnailUrl), Mode=OneWay}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="260">
                    <HyperlinkButton Padding="0" Click="OnAlbumLink" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                        <TextBlock Text="{x:Bind Player.Current.Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </HyperlinkButton>
                    <HyperlinkButton Padding="0" Click="OnArtistLink" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <TextBlock Text="{x:Bind Player.Current.ArtistsText, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}" />
                    </HyperlinkButton>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center" Click="OnLike" ToolTipService.ToolTip="{x:Bind LikeTip(Player.Like), Mode=OneWay}"
                        Visibility="{x:Bind HasSong(Player.Current), Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind LikeGlyph(Player.Like), Mode=OneWay}" Foreground="{x:Bind LikeBrush(Player.Like), Mode=OneWay}" FontSize="18" />
                </Button>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                    <ToggleButton Style="{StaticResource IconToggleStyle}" IsChecked="{x:Bind Player.Shuffle, Mode=OneWay}" Click="OnShuffle" ToolTipService.ToolTip="{x:Bind app:L.T('シャッフル', 'Shuffle')}">
                        <FontIcon Glyph="&#xE8B1;" FontSize="16" />
                    </ToggleButton>
                    <Button Style="{StaticResource IconButtonStyle}" Click="OnPrevious" ToolTipService.ToolTip="{x:Bind app:L.T('前へ', 'Previous')}">
                        <FontIcon Glyph="&#xE892;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource PlayCircleButtonStyle}" Width="40" Height="40" CornerRadius="20" Click="OnPlayPause" ToolTipService.ToolTip="{x:Bind app:L.T('再生/一時停止', 'Play/Pause')}">
                        <Grid>
                            <FontIcon Glyph="{x:Bind PlayGlyph(Player.IsPlaying), Mode=OneWay}" FontSize="16" Visibility="{x:Bind app:Ui.Hide(Player.IsLoading), Mode=OneWay}" />
                            <ProgressRing IsActive="{x:Bind Player.IsLoading, Mode=OneWay}" Width="18" Height="18" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Click="OnNext" ToolTipService.ToolTip="{x:Bind app:L.T('次へ', 'Next')}">
                        <FontIcon Glyph="&#xE893;" FontSize="16" />
                    </Button>
                    <ToggleButton Style="{StaticResource IconToggleStyle}" IsChecked="{x:Bind IsRepeating(Player.Repeat), Mode=OneWay}" Click="OnRepeat" ToolTipService.ToolTip="{x:Bind app:L.T('リピート', 'Repeat')}">
                        <FontIcon Glyph="{x:Bind RepeatGlyph(Player.Repeat), Mode=OneWay}" FontSize="16" />
                    </ToggleButton>
                </StackPanel>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind app:Ui.Time(Player.Position), Mode=OneWay}" Style="{StaticResource SubtleTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <Slider x:Name="PositionSlider" Grid.Column="1" Minimum="0" Maximum="{x:Bind MaxOf(Player.Duration), Mode=OneWay}"
                            Value="{x:Bind Player.Position, Mode=OneWay}" ValueChanged="OnPositionChanged" IsThumbToolTipEnabled="False" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{x:Bind app:Ui.Time(Player.Duration), Mode=OneWay}" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                <ToggleButton x:Name="LyricsToggle" Style="{StaticResource IconToggleStyle}" Click="OnLyricsToggle" ToolTipService.ToolTip="{x:Bind app:L.T('歌詞', 'Lyrics')}">
                    <FontIcon Glyph="&#xE720;" FontSize="16" />
                </ToggleButton>
                <ToggleButton x:Name="QueueToggle" Style="{StaticResource IconToggleStyle}" Click="OnQueueToggle" ToolTipService.ToolTip="{x:Bind app:L.T('キュー', 'Queue')}">
                    <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                </ToggleButton>
                <Button x:Name="DevicesButton" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="{x:Bind app:L.T('デバイスに接続', 'Connect to a device')}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="DevicesIcon" Glyph="&#xE772;" FontSize="16" />
                        <TextBlock x:Name="DevicesLabel" Visibility="Collapsed" MaxWidth="140" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="DevicesFlyout" Placement="Top" Opening="OnDevicesOpening">
                            <StackPanel x:Name="DevicesPanel" Width="320" Spacing="4" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <ToggleButton x:Name="PaneToggle" Style="{StaticResource IconToggleStyle}" Click="OnPaneToggle" ToolTipService.ToolTip="{x:Bind app:L.T('再生中の画面', 'Now playing view')}">
                    <FontIcon Glyph="&#xE8A0;" FontSize="16" />
                </ToggleButton>
                <Button Style="{StaticResource IconButtonStyle}" Click="OnMute" ToolTipService.ToolTip="{x:Bind app:L.T('ミュート', 'Mute')}">
                    <FontIcon Glyph="{x:Bind VolumeGlyph(Player.Volume), Mode=OneWay}" FontSize="16" />
                </Button>
                <Slider Width="110" Minimum="0" Maximum="1" StepFrequency="0.01" Value="{x:Bind Player.Volume, Mode=TwoWay}" VerticalAlignment="Center" IsThumbToolTipEnabled="False" />
            </StackPanel>
        </Grid>

    </Grid>
</Window>
