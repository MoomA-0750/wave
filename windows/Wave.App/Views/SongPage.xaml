<Page x:Class="Wave.App.Views.SongPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:app="using:Wave.App">
    <!-- 曲の画面（Android の SongScreen と同じ）: ジャケットと名前、再生ボタン、曲のメニューと同じ操作の並び -->
    <ScrollViewer>
        <StackPanel Padding="12,0,12,24">
            <Grid>
                <Rectangle x:Name="Gradient" Height="360" VerticalAlignment="Top" Margin="-12,0" />
                <Grid Padding="12,40,12,24" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="220" Height="220" CornerRadius="8" VerticalAlignment="Bottom" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                        <Image x:Name="Cover" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                        <TextBlock Text="{x:Bind app:L.T('曲', 'Song')}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="TitleText" FontSize="48" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"
                                   LineHeight="52" LineStackingStrategy="BlockLineHeight" Margin="0,2,0,6" />
                        <TextBlock x:Name="DetailText" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>
            <StackPanel Orientation="Horizontal" Padding="12,8,12,16">
                <Button Style="{StaticResource PlayCircleButtonStyle}" Click="OnPlay" ToolTipService.ToolTip="{x:Bind app:L.T('再生', 'Play')}">
                    <FontIcon Glyph="&#xF5B0;" FontSize="20" />
                </Button>
            </StackPanel>
            <StackPanel x:Name="Actions" Spacing="2" MaxWidth="480" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</Page>
