<Page x:Class="Wave.App.Views.MoodPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Wave.App.Controls"
      xmlns:music="using:Wave.Core.Music">
    <ScrollViewer>
        <StackPanel Padding="16,16,16,32" Spacing="24">
            <TextBlock x:Name="TitleText" FontSize="48" FontWeight="Bold" Margin="8,16,8,0" />
            <ProgressRing x:Name="LoadingRing" IsActive="True" HorizontalAlignment="Left" Margin="8,0" />
            <ItemsRepeater x:Name="Shelves">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="24" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="music:HomeShelf">
                        <controls:ShelfView Title="{x:Bind Title}" Strapline="{x:Bind Strapline}" Items="{x:Bind Items}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
