<Page x:Class="Wave.App.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:app="using:Wave.App"
      xmlns:controls="using:Wave.App.Controls"
      xmlns:music="using:Wave.Core.Music"
      NavigationCacheMode="Enabled">
    <!-- ホーム（Spotify と同じ並び: 絞り込みのチップ、最近聴いたものの格子、おすすめの棚） -->
    <ScrollViewer x:Name="Scroller" ViewChanged="OnScrolled">
        <StackPanel Padding="16,16,16,32" Spacing="24">
            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled">
                <StackPanel x:Name="Chips" Orientation="Horizontal" Spacing="8" Padding="8,0" />
            </ScrollViewer>

            <ItemsRepeater x:Name="RecentGrid" Margin="8,0" Visibility="Collapsed">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="240" MinItemHeight="56" MinRowSpacing="8" MinColumnSpacing="8"
                                       ItemsStretch="Fill" MaximumRowsOrColumns="4" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="music:HomeItem">
                        <Button Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="56"
                                CornerRadius="6" Click="OnRecentClick" Tag="{x:Bind}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="56" Height="56" CornerRadius="{x:Bind app:Ui.Radius(IsArtist)}">
                                    <Image Source="{x:Bind app:Ui.Small(ThumbnailUrl)}" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{x:Bind Title}" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" Margin="0,0,12,0" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- 登録したアーティストの新作（Android と同じ。アーティストごとに2件まで交互に） -->
            <controls:ShelfView x:Name="NewReleasesShelf" Visibility="Collapsed" />

            <ItemsRepeater x:Name="Shelves">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="24" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="music:HomeShelf">
                        <controls:ShelfView Title="{x:Bind Title}" Strapline="{x:Bind Strapline}" Items="{x:Bind Items}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <ProgressRing x:Name="LoadingRing" IsActive="False" HorizontalAlignment="Center" />
            <StackPanel x:Name="FailurePanel" Visibility="Collapsed" Spacing="8" HorizontalAlignment="Center">
                <TextBlock Text="{x:Bind app:L.T('ホームを読み込めませんでした', 'Couldn’t load Home')}" HorizontalAlignment="Center" />
                <Button Content="{x:Bind app:L.T('もう一度読み込む', 'Try again')}" HorizontalAlignment="Center" Click="OnRetry" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
