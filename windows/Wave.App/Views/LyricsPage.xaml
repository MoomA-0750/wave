<Page x:Class="Wave.App.Views.LyricsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Wave.App.Views">
    <!-- 歌詞（Spotify と同じく中央の枠いっぱいに、歌っている行を明るく、過ぎた行と先の行は薄く） -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Rectangle x:Name="Backdrop" Grid.RowSpan="2" />
        <ListView x:Name="Lines" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnLineClick" Padding="40,40,40,240">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:LyricRow">
                    <!-- 歌っている行は明るく少し大きく。左端を軸に大きさを変える -->
                    <TextBlock Text="{x:Bind Text}" FontSize="{x:Bind FontSize}" FontWeight="{x:Bind Weight}" TextWrapping="Wrap" Margin="{x:Bind Gap}" LineHeight="{x:Bind LineHeightOf(FontSize)}"
                               Opacity="{x:Bind Opacity, Mode=OneWay}" Scale="{x:Bind Scale, Mode=OneWay}" CenterPoint="0,16,0">
                        <TextBlock.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.35" />
                        </TextBlock.OpacityTransition>
                        <TextBlock.ScaleTransition>
                            <Vector3Transition Duration="0:0:0.35" />
                        </TextBlock.ScaleTransition>
                    </TextBlock>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <ScrollViewer x:Name="PlainView" Visibility="Collapsed">
            <TextBlock x:Name="PlainText" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" Margin="40" LineHeight="40" IsTextSelectionEnabled="True" />
        </ScrollViewer>
        <!-- 出典は歌詞に重ねず、下の段に置く -->
        <Border Grid.Row="1" Padding="40,8,40,12">
            <TextBlock x:Name="SourceText" Style="{StaticResource SubtleTextStyle}" />
        </Border>
        <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Name="EmptyText" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <!-- 読み込みに失敗したときだけ（Android と同じ） -->
            <Button x:Name="RetryButton" HorizontalAlignment="Center" Visibility="Collapsed" Click="OnRetry" Content="{x:Bind local:LyricsPage.RetryText}" />
        </StackPanel>
    </Grid>
</Page>
