<Page x:Class="Wave.App.Views.DownloadsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:app="using:Wave.App"
      xmlns:local="using:Wave.App.Views">
    <!-- ダウンロード（ADR-0016 の 14）: スマートダウンロード・丸ごと取っているもの・1曲ずつ取った曲・使っている容量と進み具合。通信なしでも開ける -->
    <ScrollViewer x:Name="Scroller">
        <StackPanel Padding="24,32,24,24" Spacing="8">
            <TextBlock Text="{x:Bind app:L.T('ダウンロード', 'Downloads')}" FontSize="48" FontWeight="Bold" Margin="12,0,12,0" />
            <TextBlock x:Name="UsageText" Style="{StaticResource SubtleTextStyle}" FontSize="14" Margin="12,0" />
            <Grid x:Name="ProgressPanel" Margin="12,4,12,0" ColumnSpacing="12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="ProgressText" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="ProgressBar" Maximum="1" MaxWidth="480" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Grid>
            <InfoBar x:Name="NetworkBar" Severity="Informational" IsClosable="False" Margin="12,4,12,0"
                     Title="{x:Bind app:L.T('通信を待っています', 'Waiting for a network')}" />

            <!-- スマートダウンロード -->
            <Grid Margin="12,24,12,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{x:Bind app:L.T('スマートダウンロード', 'Smart downloads')}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="SmartDetail" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox x:Name="SmartCountBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="110" SelectionChanged="OnSmartCountChanged" />
                <ToggleSwitch x:Name="SmartSwitch" Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent="" MinWidth="0" Toggled="OnSmartToggled" />
            </Grid>
            <StackPanel x:Name="SmartPanel" Spacing="8">
                <StackPanel x:Name="CategoryChips" Orientation="Horizontal" Spacing="8" Margin="12,8,12,0" />
                <StackPanel Orientation="Horizontal" Spacing="16" Margin="12,8,12,0">
                    <Button x:Name="SmartPlayButton" Style="{StaticResource PlayCircleButtonStyle}" Click="OnSmartPlay" ToolTipService.ToolTip="{x:Bind app:L.T('再生', 'Play')}">
                        <FontIcon Glyph="&#xF5B0;" FontSize="20" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Click="OnSmartShuffle" ToolTipService.ToolTip="{x:Bind app:L.T('シャッフル再生', 'Shuffle play')}">
                        <FontIcon Glyph="&#xE8B1;" FontSize="22" />
                    </Button>
                    <ProgressRing x:Name="SmartRing" Width="20" Height="20" IsActive="False" />
                </StackPanel>
                <ListView x:Name="SmartList" ItemTemplate="{StaticResource TrackRowTemplate}" ItemContainerStyle="{StaticResource TrackListItemStyle}"
                          SelectionMode="Single" DoubleTapped="OnSmartDoubleTapped" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                <TextBlock x:Name="SmartEmpty" Style="{StaticResource SubtleTextStyle}" Margin="12,0" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 丸ごと取っているもの -->
            <TextBlock Text="{x:Bind app:L.T('プレイリスト・アルバム', 'Playlists and albums')}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="12,24,12,0" />
            <ListView x:Name="CollectionList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnCollectionClick"
                      ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:DownloadCollectionRow">
                        <Grid ColumnSpacing="12" Height="60">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="4" Background="{x:Bind CoverBackground}">
                                <Grid>
                                    <FontIcon Glyph="&#xEB52;" Foreground="White" FontSize="18" Visibility="{x:Bind app:Ui.Show(IsLiked)}" />
                                    <Image Source="{x:Bind app:Ui.Small(ThumbnailUrl)}" Stretch="UniformToFill" Visibility="{x:Bind app:Ui.Hide(IsLiked)}" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="CollectionEmpty" Style="{StaticResource SubtleTextStyle}" Margin="12,0" TextWrapping="Wrap"
                       Text="{x:Bind app:L.T('プレイリスト・アルバム・高く評価した曲のページの頭にある ↓ で、丸ごと取っておけます', 'Use ↓ at the top of a playlist, album or Liked Songs to download it')}" />

            <!-- 1曲ずつ取った曲・エピソード -->
            <TextBlock Text="{x:Bind app:L.T('曲', 'Songs')}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="12,24,12,0" />
            <ListView x:Name="SingleList" ItemTemplate="{StaticResource TrackRowTemplate}" ItemContainerStyle="{StaticResource TrackListItemStyle}"
                      SelectionMode="Single" DoubleTapped="OnSingleDoubleTapped" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
            <TextBlock x:Name="SingleEmpty" Style="{StaticResource SubtleTextStyle}" Margin="12,0" TextWrapping="Wrap"
                       Text="{x:Bind app:L.T('曲やエピソードのメニューの「ダウンロード」で、1曲ずつ取っておけます', 'Choose Download from a song or episode menu to keep it on this PC')}" />
            <TextBlock x:Name="EpisodeHeader" Text="{x:Bind app:L.T('エピソード', 'Episodes')}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="12,24,12,0" />
            <ListView x:Name="EpisodeList" ItemTemplate="{StaticResource TrackRowTemplate}" ItemContainerStyle="{StaticResource TrackListItemStyle}"
                      SelectionMode="Single" DoubleTapped="OnEpisodeDoubleTapped" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
        </StackPanel>
    </ScrollViewer>
</Page>
