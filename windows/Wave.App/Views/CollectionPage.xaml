<Page x:Class="Wave.App.Views.CollectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:app="using:Wave.App">
    <!-- プレイリスト・アルバムのページ（Spotify と同じ: ジャケットの色のグラデーション、大きなジャケットと名前、再生ボタン、曲の表） -->
    <ListView x:Name="Tracks" ItemTemplate="{StaticResource TrackRowTemplate}" ItemContainerStyle="{StaticResource TrackListItemStyle}"
              SelectionMode="Single" DoubleTapped="OnDoubleTapped" Padding="12,0,12,24" KeyDown="OnKeyDown">
        <ListView.Header>
            <StackPanel>
                <Grid>
                    <Rectangle x:Name="Gradient" Height="360" VerticalAlignment="Top" Margin="-12,0" />
                    <Grid Padding="12,40,12,24" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CoverBorder" Width="220" Height="220" CornerRadius="8" VerticalAlignment="Bottom" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <Grid>
                                <FontIcon x:Name="LikedIcon" Glyph="&#xEB52;" FontSize="72" Foreground="White" Visibility="Collapsed" />
                                <Image x:Name="Cover" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <!-- 題名・アーティスト（アルバムだけ。押すとアーティストのページ）・説明。下端をジャケットの下端にそろえる。並びは Android と同じ -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="0">
                            <TextBlock x:Name="TitleText" FontSize="56" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"
                                       LineHeight="58" LineStackingStrategy="BlockLineHeight" Margin="0,2,0,6" />
                            <HyperlinkButton x:Name="ArtistLink" Padding="0" Margin="0,0,0,2" Visibility="Collapsed" Click="OnArtistLink" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                                <TextBlock x:Name="ArtistText" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            </HyperlinkButton>
                            <TextBlock x:Name="DetailText" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
                <Grid Padding="12,8,12,16">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Button x:Name="PlayButton" Style="{StaticResource PlayCircleButtonStyle}" Click="OnPlay" ToolTipService.ToolTip="{x:Bind app:L.T('再生', 'Play')}" IsEnabled="False">
                        <FontIcon x:Name="PlayIcon" Glyph="&#xF5B0;" FontSize="20" />
                    </Button>
                    <ToggleButton x:Name="ShuffleButton" Style="{StaticResource IconToggleStyle}" Click="OnShuffle" ToolTipService.ToolTip="{x:Bind app:L.T('シャッフル', 'Shuffle')}">
                        <FontIcon Glyph="&#xE8B1;" FontSize="22" />
                    </ToggleButton>
                    <Button x:Name="MoreButton" Style="{StaticResource IconButtonStyle}" Click="OnMore" ToolTipService.ToolTip="{x:Bind app:L.T('その他', 'More')}">
                        <FontIcon Glyph="&#xE712;" FontSize="20" />
                    </Button>
                    <ProgressRing x:Name="LoadingRing" IsActive="True" Width="20" Height="20" />
                </StackPanel>
                <!-- 右端: 一覧の中を探す（🔍で開く）と並べ替え（Spotify と同じ） -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                    <Button Style="{StaticResource IconButtonStyle}" Click="OnSearchToggle" ToolTipService.ToolTip="{x:Bind app:L.T('この一覧の中を検索', 'Search in this list')}">
                        <FontIcon Glyph="&#xE721;" FontSize="16" />
                    </Button>
                    <TextBox x:Name="FilterBox" Width="240" Visibility="Collapsed" PlaceholderText="{x:Bind app:L.T('この一覧の中を検索', 'Search in this list')}"
                             TextChanged="OnFilterChanged" KeyDown="OnFilterKeyDown" VerticalAlignment="Center" />
                    <DropDownButton Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                        <TextBlock x:Name="SortText" Text="{x:Bind app:L.T('カスタム順', 'Custom order')}" Style="{StaticResource SubtleTextStyle}" FontSize="14" />
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedRight" Opening="OnSortOpening" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
                </Grid>
                <Grid Padding="12,0,12,8" ColumnSpacing="12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition x:Name="AlbumHeaderColumn" Width="2*" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="#" HorizontalAlignment="Right" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind app:L.T('タイトル', 'Title')}" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Grid.Column="2" x:Name="AlbumHeader" Text="{x:Bind app:L.T('アルバム', 'Album')}" Style="{StaticResource SubtleTextStyle}" />
                    <FontIcon Grid.Column="3" Glyph="&#xE823;" FontSize="14" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <TextBlock x:Name="ErrorText" Visibility="Collapsed" Margin="12,24" />
                <TextBlock x:Name="NoMatchText" Visibility="Collapsed" Margin="12,24" Style="{StaticResource SubtleTextStyle}" Text="{x:Bind app:L.T('一致する曲はありません', 'No matching songs')}" />
            </StackPanel>
        </ListView.Header>
    </ListView>
</Page>
