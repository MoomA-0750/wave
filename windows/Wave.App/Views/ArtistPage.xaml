<Page x:Class="Wave.App.Views.ArtistPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Wave.App.Controls"
      xmlns:music="using:Wave.Core.Music">
    <!-- アーティストのページ（Spotify と同じ: 横いっぱいの画像に名前、再生ボタン、人気の曲、ディスコグラフィー） -->
    <ScrollViewer>
        <StackPanel Spacing="16" Padding="0,0,0,32">
            <Grid Height="320">
                <Image x:Name="Hero" Stretch="UniformToFill" VerticalAlignment="Center" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0.3" />
                            <GradientStop Color="#B0000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <StackPanel VerticalAlignment="Bottom" Padding="24">
                    <TextBlock x:Name="NameText" FontSize="72" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="16" Padding="24,0">
                <Button x:Name="PlayButton" Style="{StaticResource PlayCircleButtonStyle}" Click="OnPlay" ToolTipService.ToolTip="再生" IsEnabled="False">
                    <FontIcon x:Name="PlayIcon" Glyph="&#xF5B0;" FontSize="20" />
                </Button>
                <ToggleButton x:Name="ShuffleButton" Style="{StaticResource IconToggleStyle}" Click="OnShuffle" ToolTipService.ToolTip="シャッフル">
                    <FontIcon Glyph="&#xE8B1;" FontSize="22" />
                </ToggleButton>
                <ProgressRing x:Name="LoadingRing" IsActive="True" Width="20" Height="20" />
            </StackPanel>
            <TextBlock Text="人気" Style="{StaticResource SubtitleTextBlockStyle}" Margin="24,8,24,0" />
            <ListView x:Name="TopSongs" Margin="12,0" ItemTemplate="{StaticResource TrackRowTemplate}" ItemContainerStyle="{StaticResource TrackListItemStyle}"
                      ScrollViewer.VerticalScrollMode="Disabled" DoubleTapped="OnDoubleTapped" />
            <HyperlinkButton x:Name="AllSongs" Content="すべての曲を見る" Margin="20,0" Click="OnAllSongs" Visibility="Collapsed" />
            <ItemsRepeater x:Name="Shelves" Margin="16,8,16,0">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="24" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="music:HomeShelf">
                        <controls:ShelfView Title="{x:Bind Title}" Items="{x:Bind Items}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <TextBlock x:Name="ErrorText" Visibility="Collapsed" Margin="24" Text="アーティストを読み込めませんでした" />
        </StackPanel>
    </ScrollViewer>
</Page>
