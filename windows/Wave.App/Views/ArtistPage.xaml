<Page x:Class="Wave.App.Views.ArtistPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:app="using:Wave.App"
      xmlns:controls="using:Wave.App.Controls"
      xmlns:music="using:Wave.Core.Music">
    <!-- アーティストのページ（Spotify と同じ: 横いっぱいの画像に名前、再生ボタン、人気の曲、ディスコグラフィー） -->
    <ScrollViewer>
        <StackPanel Spacing="16" Padding="0,0,0,32">
            <Grid Height="320">
                <Image x:Name="Hero" Stretch="UniformToFill" VerticalAlignment="Center" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0.3" />
                            <GradientStop Color="#B0000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- 名前と、枠の右端に登録（Spotify の「フォロー」）。大きさが違うので上下中央ではなく、名前の文字の下端（ベースライン）に揃える。登録していなければ色を付けて目立たせる -->
                <Grid VerticalAlignment="Bottom" Padding="24" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NameText" VerticalAlignment="Bottom" FontSize="72" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="SubscribeButton" Grid.Column="1" Visibility="Collapsed" Click="OnSubscribe" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,16" CornerRadius="16" Padding="16,6" />
                </Grid>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="16" Padding="24,0">
                <Button x:Name="PlayButton" Style="{StaticResource PlayCircleButtonStyle}" Click="OnPlay" ToolTipService.ToolTip="{x:Bind app:L.T('再生', 'Play')}" Visibility="Collapsed">
                    <FontIcon x:Name="PlayIcon" Glyph="&#xF5B0;" FontSize="20" />
                </Button>
                <ToggleButton x:Name="ShuffleButton" Style="{StaticResource IconToggleStyle}" Click="OnShuffle" ToolTipService.ToolTip="{x:Bind app:L.T('シャッフル', 'Shuffle')}">
                    <FontIcon Glyph="&#xE8B1;" FontSize="22" />
                </ToggleButton>
                <ProgressRing x:Name="LoadingRing" IsActive="True" Width="20" Height="20" />
            </StackPanel>
            <!-- ライブ・ツアーの告知（アーティストの YouTube のチャンネルの投稿から。Android と同じ）。告知が無ければ出さない -->
            <StackPanel x:Name="LivePanel" Visibility="Collapsed" Spacing="8">
                <TextBlock Text="{x:Bind app:L.T('ライブ・お知らせ', 'Live &amp; news')}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="24,8,24,0" />
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="LivePosts" Orientation="Horizontal" Spacing="12" Padding="24,0,24,8" />
                </ScrollViewer>
            </StackPanel>
            <TextBlock Text="{x:Bind app:L.T('人気', 'Popular')}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="24,8,24,0" />
            <ListView x:Name="TopSongs" Margin="12,0" ItemTemplate="{StaticResource TrackRowTemplate}" ItemContainerStyle="{StaticResource TrackListItemStyle}"
                      ScrollViewer.VerticalScrollMode="Disabled" DoubleTapped="OnDoubleTapped" />
            <HyperlinkButton x:Name="AllSongs" Content="{x:Bind app:L.T('すべての曲を見る', 'See all songs')}" Margin="20,0" Click="OnAllSongs" Visibility="Collapsed" />
            <!-- Spotify の「高く評価した曲」の行（このアーティストの、自分が高く評価した曲）。1曲も無ければ出さない -->
            <Button x:Name="LikedRow" Margin="24,0" Padding="8" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Click="OnLiked" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Grid Width="56" Height="56">
                        <Ellipse>
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF450AF5" Offset="0" />
                                    <GradientStop Color="#FFC4EFD9" Offset="1" />
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <FontIcon Glyph="&#xEB52;" FontSize="20" Foreground="White" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind app:L.T('高く評価した曲', 'Liked Songs')}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="LikedText" Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>
                </StackPanel>
            </Button>
            <ItemsRepeater x:Name="Shelves" Margin="16,8,16,0">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="24" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="music:HomeShelf">
                        <controls:ShelfView Title="{x:Bind Title}" Items="{x:Bind Items}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <TextBlock x:Name="ErrorText" Visibility="Collapsed" Margin="24" Text="{x:Bind app:L.T('アーティストを読み込めませんでした', 'Couldn’t load the artist')}" />
        </StackPanel>
    </ScrollViewer>
</Page>
