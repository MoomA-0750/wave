<Page x:Class="Wave.App.Views.PodcastPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:app="using:Wave.App"
      xmlns:music="using:Wave.Core.Music"
      xmlns:views="using:Wave.App.Views">
    <!-- ポッドキャストの番組のページ（Android と同じ並び: ジャケット・題・配信者・説明、再生と保存、新しい順のエピソード） -->
    <ListView x:Name="Episodes" SelectionMode="Single" DoubleTapped="OnDoubleTapped" Padding="12,0,12,24">
        <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="12,0" />
            </Style>
        </ListView.ItemContainerStyle>
        <ListView.Header>
            <StackPanel>
                <Grid Padding="12,40,12,24" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="220" Height="220" CornerRadius="8" VerticalAlignment="Top" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                        <Image x:Name="Cover" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
                        <TextBlock Text="{x:Bind app:L.T('ポッドキャスト', 'Podcast')}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="TitleText" FontSize="48" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                        <TextBlock x:Name="AuthorText" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DescriptionText" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                        <HyperlinkButton x:Name="MoreLink" Padding="0" Visibility="Collapsed" Click="OnMoreDescription" Content="{x:Bind app:L.T('すべて表示', 'Show more')}" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="16" Padding="12,0,12,16">
                    <Button x:Name="PlayButton" Style="{StaticResource PlayCircleButtonStyle}" Click="OnPlay" ToolTipService.ToolTip="{x:Bind app:L.T('再生', 'Play')}" Visibility="Collapsed">
                        <FontIcon Glyph="&#xF5B0;" FontSize="20" />
                    </Button>
                    <Button x:Name="SaveButton" Visibility="Collapsed" Click="OnSave" VerticalAlignment="Center" CornerRadius="16" Padding="16,6" />
                    <ProgressRing x:Name="LoadingRing" IsActive="True" Width="20" Height="20" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" Visibility="Collapsed" Margin="12,24" Text="{x:Bind app:L.T('番組を読み込めませんでした', 'Could not load the podcast')}" />
            </StackPanel>
        </ListView.Header>
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="music:PodcastEpisode">
                <Grid Padding="0,10" ColumnSpacing="16" Background="Transparent" RightTapped="OnRowRightTapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="112" Height="63" CornerRadius="6" VerticalAlignment="Top" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                        <Image Source="{x:Bind app:Ui.Small(Song.ThumbnailUrl)}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{x:Bind Song.Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind DateAndLength}" Style="{StaticResource SubtleTextStyle}" />
                        <TextBlock Text="{x:Bind Description}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Width="160" HorizontalAlignment="Left" Margin="0,4,0,0" Maximum="100"
                                     Value="{x:Bind views:PodcastPage.ProgressValue(ProgressPercent)}" Visibility="{x:Bind views:PodcastPage.ProgressVisible(ProgressPercent)}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</Page>
