<Page x:Class="Wave.App.Views.PodcastPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:app="using:Wave.App"
      xmlns:music="using:Wave.Core.Music"
      xmlns:views="using:Wave.App.Views">
    <!-- ポッドキャストの番組のページ（Android と同じ並び: ジャケット・題・配信者・説明、再生と保存、新しい順のエピソード） -->
    <ListView x:Name="Episodes" SelectionMode="Single" DoubleTapped="OnDoubleTapped" Padding="12,0,12,24">
        <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="12,0" />
            </Style>
        </ListView.ItemContainerStyle>
        <ListView.Header>
            <StackPanel>
                <!-- 頭はアルバムのページ（CollectionPage）と同じ見せ方: ジャケットの色のグラデーション、下端をそろえたジャケットと題・配信者・説明 -->
                <Grid>
                    <Rectangle x:Name="Gradient" Height="360" VerticalAlignment="Top" Margin="-12,0" />
                    <Grid Padding="12,40,12,24" ColumnSpacing="{StaticResource KasaneSpace6}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="220" Height="220" CornerRadius="{StaticResource KasaneCornerRadiusLg}" VerticalAlignment="Bottom" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <Image x:Name="Cover" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="0">
                            <TextBlock x:Name="TitleText" FontSize="56" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"
                                       LineHeight="58" LineStackingStrategy="BlockLineHeight" Margin="0,2,0,6" />
                            <TextBlock x:Name="AuthorText" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                            <TextBlock x:Name="DescriptionText" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                            <HyperlinkButton x:Name="MoreLink" Padding="0" Visibility="Collapsed" Click="OnMoreDescription" Content="{x:Bind app:L.T('すべて表示', 'Show more')}" />
                        </StackPanel>
                    </Grid>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource KasaneSpace4}" Padding="12,8,12,16">
                    <Button x:Name="PlayButton" Style="{StaticResource PlayCircleButtonStyle}" Click="OnPlay" ToolTipService.ToolTip="{x:Bind app:L.T('再生', 'Play')}" Visibility="Collapsed">
                        <FontIcon Glyph="&#xF5B0;" FontSize="20" />
                    </Button>
                    <!-- 保存はアルバムの保存と同じ見た目 -->
                    <Button x:Name="SaveButton" Visibility="Collapsed" Click="OnSave" VerticalAlignment="Center" CornerRadius="16" Padding="16,6" />
                    <ProgressRing x:Name="LoadingRing" IsActive="True" Width="20" Height="20" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" Visibility="Collapsed" Margin="12,24" Text="{x:Bind app:L.T('ポッドキャストを読み込めませんでした', 'Couldn^'t load the podcast')}" />
            </StackPanel>
        </ListView.Header>
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="music:PodcastEpisode">
                <Grid Padding="0,10" ColumnSpacing="{StaticResource KasaneSpace4}" Background="Transparent" RightTapped="OnRowRightTapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- 行の絵は正方形で切り抜く。エピソードの絵（i.ytimg の hq720 など 16:9）は、音声の番組だと正方形の番組の絵の左右に黒い帯が焼き込まれているので、16:9 の枠だと帯まで出る（Android の行と同じ 64 の正方形）。Image の UniformToFill は枠からはみ出た分を右・下から切る（左の帯が残る）ので、ImageBrush で真ん中を切る -->
                    <Grid Width="64" Height="64" CornerRadius="{StaticResource KasaneCornerRadiusSm}" VerticalAlignment="Top" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                        <Border CornerRadius="{StaticResource KasaneCornerRadiusSm}">
                            <Border.Background>
                                <ImageBrush ImageSource="{x:Bind app:Ui.Small(Song.ThumbnailUrl)}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{x:Bind Song.Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <!-- 取り終えたエピソードには↓の印（ADR-0016） -->
                            <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind views:PodcastPage.DownloadedVisible(Song.VideoId)}"
                                      ToolTipService.ToolTip="{x:Bind app:L.T('ダウンロード済み', 'Downloaded')}" />
                            <TextBlock Text="{x:Bind DateAndLength}" Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Description}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Width="160" HorizontalAlignment="Left" Margin="0,4,0,0" Maximum="100"
                                     Value="{x:Bind views:PodcastPage.ProgressValue(ProgressPercent)}" Visibility="{x:Bind views:PodcastPage.ProgressVisible(ProgressPercent)}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</Page>
