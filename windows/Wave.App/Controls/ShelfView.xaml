<UserControl x:Class="Wave.App.Controls.ShelfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Wave.App"
             xmlns:controls="using:Wave.App.Controls"
             xmlns:music="using:Wave.Core.Music">
    <!-- 横に流れる棚（見出しと、左右に送るボタン） -->
    <StackPanel Spacing="4">
        <Grid Padding="8,0">
            <StackPanel>
                <TextBlock Text="{x:Bind Strapline, Mode=OneWay}" Style="{StaticResource SubtleTextStyle}" Visibility="{x:Bind app:Ui.ShowText(Strapline), Mode=OneWay}" />
                <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource ShelfTitleStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="4">
                <!-- 押せないほうは見えなくする（場所は残し、見出しの高さが変わらないようにする） -->
                <Button x:Name="LeftButton" Style="{StaticResource IconButtonStyle}" Click="OnLeft" Opacity="0" IsEnabled="False" ToolTipService.ToolTip="{x:Bind app:L.T('前へ', 'Previous')}">
                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                </Button>
                <Button x:Name="RightButton" Style="{StaticResource IconButtonStyle}" Click="OnRight" Opacity="0" IsEnabled="False" ToolTipService.ToolTip="{x:Bind app:L.T('次へ', 'Next')}">
                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="Scroller" ViewChanged="OnViewChanged" SizeChanged="OnScrollerSizeChanged" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <ItemsRepeater ItemsSource="{x:Bind Items, Mode=OneWay}" SizeChanged="OnScrollerSizeChanged">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="music:HomeItem">
                        <controls:MediaCard Item="{x:Bind}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </StackPanel>
</UserControl>
