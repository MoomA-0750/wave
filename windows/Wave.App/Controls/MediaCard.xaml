<UserControl x:Class="Wave.App.Controls.MediaCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Wave.App">
    <!-- 棚のカード（Spotify と同じ: 画像・名前・補足。乗せると再生ボタンが出る） -->
    <Grid x:Name="Root" Width="{StaticResource CardWidth}" Padding="8" CornerRadius="8" RowSpacing="8"
          Background="Transparent" PointerEntered="OnEnter" PointerExited="OnExit" Tapped="OnTapped"
          RightTapped="OnRightTapped">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Border x:Name="Cover" Height="160" Width="160" CornerRadius="{x:Bind app:Ui.CoverRadius(Item), Mode=OneWay}"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                <Image Source="{x:Bind app:Ui.Img(Item.ThumbnailUrl), Mode=OneWay}" Stretch="UniformToFill" />
            </Border>
            <Button x:Name="PlayButton" Style="{StaticResource PlayCircleButtonStyle}" Width="44" Height="44" CornerRadius="22"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6" Opacity="0"
                    Click="OnPlay" ToolTipService.ToolTip="{x:Bind app:L.T('再生', 'Play')}">
                <Button.OpacityTransition>
                    <ScalarTransition />
                </Button.OpacityTransition>
                <FontIcon Glyph="&#xF5B0;" FontSize="16" />
            </Button>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="2">
            <TextBlock Text="{x:Bind Item.Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
            <TextBlock Text="{x:Bind Subtitle(Item), Mode=OneWay}" Style="{StaticResource SubtleTextStyle}" MaxLines="2" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
