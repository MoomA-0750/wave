# wave の AI 中継（家の PC で常駐）。~/.config/systemd/user/ に置いて使う。
# tailnet へは tailscale serve で HTTPS にして出す（外へは出さない）:
#   tailscale serve --bg --https=10447 http://127.0.0.1:8797
[Unit]
Description=wave AI bridge (claude -p)
After=network-online.target

[Service]
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/Documents/git-cloned/wave/tools/ai-bridge/wave_ai_bridge.py --host 127.0.0.1 --port 8797
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
