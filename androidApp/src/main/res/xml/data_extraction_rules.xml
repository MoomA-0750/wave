<?xml version="1.0" encoding="utf-8"?>
<!-- 認証情報の暗号文を含むため、クラウドバックアップにも端末間の転送にも一切含めない（Android 12 以降は allowBackup="false" だけでは端末間の転送を止められない） -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
