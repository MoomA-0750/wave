<?xml version="1.0" encoding="utf-8"?>
<!-- スマホ版だけのもの（画面・カメラ） -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ペアリングの QR を読むときだけ使う -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application>
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 通知の「プレイリストに追加」から開く、ダイアログだけの透明な画面 -->
        <activity
            android:name=".library.AddToPlaylistActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    </application>

</manifest>
