<?xml version="1.0" encoding="utf-8"?>
<!-- スマホ版だけのもの（画面・カメラ） -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ペアリングの QR を読むときだけ使う -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- wave が裏にいる間、ほかのアプリの上に再生の丸を重ねる（設定でオンにしたときだけ） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application>
        <activity
            android:name=".MainActivity"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 通知の「プレイリストに追加」から開く、ダイアログだけの透明な画面 -->
        <activity
            android:name=".library.AddToPlaylistActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- ホーム画面のウィジェット: 再生中の曲 -->
        <receiver
            android:name=".widget.NowPlayingWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_now_playing_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_playing_widget_info" />
        </receiver>

        <!-- ホーム画面のウィジェット: 次に流れる曲（キュー） -->
        <receiver
            android:name=".widget.QueueWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_queue_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/queue_widget_info" />
        </receiver>

        <!-- ランチャーのアイコンの長押しの「最近のプレイリストを再生」から開く、画面を出さずに鳴らすだけの入口 -->
        <activity
            android:name=".widget.PlaylistShortcutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- ホーム画面に置いた「鳴らすもの」のショートカットから開く、画面を出さずに鳴らすだけの入口 -->
        <activity
            android:name=".widget.ItemShortcutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- ランチャーのウィジェットの一覧の「ショートカット」に出す「wave: 再生」。置くと鳴らすものを選ぶ -->
        <activity
            android:name=".widget.CreatePlayShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/shortcut_create_label"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            ほかのアプリ（Tasker など）から呼ぶ再生の口。受けるのは再生の操作だけで、何も返さない。
            extra xyz.mooma0750.wave.extra.LINK（または data）に YouTube / YouTube Music の URL か ID、xyz.mooma0750.wave.extra.SHUFFLE（boolean）
        -->
        <activity
            android:name=".widget.PlayIntentActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="xyz.mooma0750.wave.action.PLAY" />
                <action android:name="xyz.mooma0750.wave.action.PAUSE" />
                <action android:name="xyz.mooma0750.wave.action.PLAY_PAUSE" />
                <action android:name="xyz.mooma0750.wave.action.NEXT" />
                <action android:name="xyz.mooma0750.wave.action.PREVIOUS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="xyz.mooma0750.wave.action.PLAY" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="https" />
                <data android:scheme="http" />
            </intent-filter>
        </activity>

        <!-- ホーム画面のウィジェット: 1つのプレイリスト（置くときに選ぶ） -->
        <receiver
            android:name=".widget.PlaylistWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_playlist_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/playlist_widget_info" />
        </receiver>

        <!-- ホーム画面のウィジェット: プレイリストを並べる（最近再生した順か、選んだもの） -->
        <receiver
            android:name=".widget.PlaylistGridWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_playlists_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/playlist_grid_widget_info" />
        </receiver>

        <activity
            android:name=".widget.PlaylistGridConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.PlaylistWidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

    </application>

</manifest>
