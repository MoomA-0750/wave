<?xml version="1.0" encoding="utf-8"?>
<!-- スマホ版だけのもの（画面・カメラ） -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ペアリングの QR を読むときだけ使う -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application>
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 通知の「プレイリストに追加」から開く、ダイアログだけの透明な画面 -->
        <activity
            android:name=".library.AddToPlaylistActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- ホーム画面のウィジェット: 再生中の曲 -->
        <receiver
            android:name=".widget.NowPlayingWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_now_playing_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_playing_widget_info" />
        </receiver>

        <!-- ホーム画面のウィジェット: 1つのプレイリスト（置くときに選ぶ） -->
        <receiver
            android:name=".widget.PlaylistWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_playlist_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/playlist_widget_info" />
        </receiver>

        <activity
            android:name=".widget.PlaylistWidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

    </application>

</manifest>
